# Form endpoints only. The helper file and private fallback folder are never served.
Options -Indexes
<FilesMatch "^(_lib\.php|.*\.(csv|json|log|pem|key|txt|tmp))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_headers.c>
  Header set Cache-Control "no-store"
  Header set X-Robots-Tag "noindex"
</IfModule>
